<%- include('../partials/header') %>

    <div class="d-flex justify-content-center">
        <div class="container bg-white py-5 m-2 d-flex flex-column justify-content-center ">

            <h1 class="title text-center pb-2" style="font-size: 2.1rem;">Registrarme</h1>

            <form class="border-top border-secondary p-5" action="/user/register" method="POST">


               

                        <div class="form-row">
                            <div class="form-group col-md-6">
                               
                                <label for="name">Nombre y apellido:</label>
                                <input id="floatingInput" type="text" name="name" class="form-control"
                                    value="<%= locals.oldData ? oldData.name : null %>">

                                    <% if (locals.errors && errors.name) { %>
                                        <span class="barra text-danger">
                                           <p class="pt-2"><%= errors.name.msg %></p> 
                                        </span>
                                        <% } %>
                             
                            </div>
                            <div class="form-group col-md-6">
                                <label for="email">Email:</label>
                                <input id="floatingInput"
                                    placeholder="" type="email"
                                    class="form-control" name="email"
                                    value="<%= locals.oldData ? oldData.email : null %>">
                                    <small id="emailHelp" class="form-text muted text-secondary"> Ingresa tu mail para ponernos en contacto con el envio de tus fotos</small>

                                    <% if (locals.errors && errors.email) { %>
                                        <span class="barra text-danger py-2">
                                            <p class="pt-2"><%= errors.email.msg %></p>
                                        </span>
                                        <% } %>

                              
                            </div>
                        </div>


                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="address">Direccion:</label>
                                <input class="form-control" placeholder=""
                                    id="floatingInput" type="text" name="address"
                                    value="<%= locals.oldData ? oldData.address : null %>">

                                    <small id="emailHelp" class="form-text muted text-secondary">Direccion a donde te enviaremos tus fotos</small>

                                    <% if (locals.errors && errors.address) { %>
                                        <span class="barra text-danger py-2">
                                            <p class="pt-2"><%= errors.address.msg %></p>
                                        </span>
                                        <% } %>
                               
                                      
                            </div>
                            <div class="form-group col-md-6">

                                <label for="password">Contraseña:</label>
                                <input id="floatingInput" type="password" class="form-control" name="password">
                                <% if (locals.errors && errors.password) { %>
                                    <span class="barra text-danger py-2">
                                        <p class="pt-2"><%= errors.password.msg %></p>
                                    </span>
                                    <% } %>
                            </div>
                        </div>


                        <div class="d-flex justify-content-center p-3">
                            <button style="background-color: #373e98; border: none;" class="btn btn-primary my-3"
                                type="submit">Registrarme</button>
                        </div>
            </form>
        </div>
    </div>
    <%- include('../partials/footer') %>