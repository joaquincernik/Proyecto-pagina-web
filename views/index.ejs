<%- include('./partials/header') %>

  <div class="bg-white">

    <div class="container-fluid">
      <section class="jumbotron text-center bg-white pt-5">
        <!-- <h1 style=" font-family: 'Barlow Semi Condensed', sans-serif;
    font-weight: 400;
    font-style: normal; font-size: 40px;">Seguinos en nuestras redes sociales</h1> -->
        <h1 class=" text-center pb-5" style="font-family: 'Barlow Semi Condensed', sans-serif;
        font-weight: 400;
        font-style: normal;font-size: 3.5rem;">Seguinos en nuestras redes sociales</h1>

        <div class="row pt-3">
          <div class="col-md-4 my-2">
            <div class="d-flex flex-column justify-content-center align-items-center">

              <a style="text-decoration: none;" href="https://www.youtube.com/@gustavorosso7650">
                <i class="fa fa-brands fa-youtube  text-danger" style="font-size: 50px;"></i>
              </a>
              <a style="text-decoration: none;" class="pt-3 text-secondary"
                href="https://www.youtube.com/@gustavorosso7650">
                <h2 class="text-center" style="font-family: 'Barlow Semi Condensed', sans-serif;
                    font-weight: 200;
                    font-style: normal;font-size: 1.3rem;">Seguinos en nuestro canal de youtube</h2>
              </a>
            </div>
          </div>

          <div class="col-md-4 my-2">
            <div class="d-flex flex-column justify-content-center align-items-center">
              <a style="text-decoration: none;" href="https://www.facebook.com/rossogustavo.com.ar/?fref=ts">
                <i class="fa fa-brands fa-facebook pt-1 px-2 text-primary" style="font-size: 50px;"></i>
              </a>
              <a style="text-decoration: none;" class="pt-3 text-secondary"
                href="https://www.facebook.com/rossogustavo.com.ar/?fref=ts">
                <h2 class="text-center" style="font-family: 'Barlow Semi Condensed', sans-serif;
                font-weight: 200;
                font-style: normal;font-size: 1.3rem;">@rossogustavo</h2>
              </a>
            </div>

          </div>

          <div class="col-md-4 my-2">
            <div class="d-flex flex-column justify-content-center align-items-center">
              <a style="text-decoration: none;" class="pt-3 text-secondary"
                href="https://api.whatsapp.com/send?phone=543537513657">
                <i class="fa fa-brands fa-whatsapp pt-1 px-2 text-success" style="font-size: 50px;"></i>
              </a>

              <a style="text-decoration: none;" class="pt-3 text-secondary"
                href="https://api.whatsapp.com/send?phone=543537513657">
                <h2 class="text-center" style="font-family: 'Barlow Semi Condensed', sans-serif;
                    font-weight: 200;
                    font-style: normal;font-size: 1.3rem;">Envianos un whatsapp</h2>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <hr class="hr hr-blurry w-75" style="background-color: #f8f9fc;" />

    <div class="container">
      <div class="row bg-white p-4 py-5">
        <div class="col-md-4 d-flex justify-content-center align-items-center">
          <div class="">
            <img src="/images/galeria.png" style="width: 17.5vw;">
          </div>
        </div>
        <div class="col-md-8 px-3">
          <h1 style=" font-family: 'Oswald', sans-serif;
        font-weight: 400;
        font-style: normal; font-size: 3.5rem;" class="pb-5 como-pido">¿Cómo pido mis fotos?</h1>

          <p class="lead" style="font-size: 1.3rem; line-height: 1.7;">Lo unico que tenes que hacer es
            <b>registrarte</b> con los datos que luego seran
            utiles para que recibas tus fotos, y elegir las fotos que te gustan!
          </p>
          <p class="lead" style="font-size: 1.3rem;line-height: 1.7;">Busca las fotos que te gustaria pedir y solo
            pulsando el boton <b>añadir al
              carrito</b>, nos pondremos en contacto con vos para que puedas recibirlas!</p>
          <a href="/user/register"><button type="button" class="btn btn-outline-danger mt-2"
              style="font-size: 1rem;">¿No tenes una cuenta? Registrate aqui</button></a>
        </div>
      </div>
    </div>


    <div class="py-5">
      <h1 style=" font-family: 'Bebas Neue', sans-serif;
       font-weight: 400;
       font-style: center; font-size: 4.5rem;" class="py-3 px-2 text-center">¿Ya realizaste tu pedido?</h1>
      <a href="/orders/mis-ordenes" class="d-flex align-items-center justify-content-center" style="text-decoration: none;">
        <button type="button" class="btn btn-outline-primary mt-2 mb-5" style="font-size: 1rem;">
          <div class="d-flex align-items-center">
            <span class="material-symbols-outlined">photo_library</span>
            <p class="pt-3 px-2">Ver mis pedidos</p>
          </div>
        </button>
      </a>
    </div>
  </div>
  <hr class="hr hr-blurry w-75" style="background-color: #f8f9fc; margin: 0;" />

  <div class="mt-4 p-4">
    <h1 class="text-center py-5" style=" font-family: 'Barlow Semi Condensed', sans-serif;
    font-weight: 400;
    font-style: normal;; font-size: 3rem;">Últimos albumes agregados</h1>
    <div class="row">

      <% albums.map(album=> {%>

        <div class="col-md-4 album">
          <div class="card h-100 p-3 border border-light">

            <a href="/orders/create/<%= album.album_id %>">
              <img class="card-img-top" style="width: 100%;object-fit: contain; "
                src="/images/<%=album.cover%>">
            </a>
            <div class="card-body">
              <h1 style="font-size: 1rem;" class="text-center card-title">
                <a class="text-dark card-title" style="text-decoration: none;"
                  href="/orders/create/<%= album.album_id %>">
                  <%= album.name %>
                </a>
              </h1>
              <p class="text-muted text-center card-text pt-2" style="font-size: 0.8rem;">Creado el <%= album.date %>
              </p>
            </div>
          </div>
        </div>
        <%}); %>
    </div>

    <div class="py-5">
      <a href="/albums/list" class="d-flex align-items-center justify-content-center" style="text-decoration: none;">
        <button type="button" class="btn btn-outline-success mt-1 mb-4" style="font-size: 0.8rem;">
          <div class="d-flex align-items-center">
            <span class="material-symbols-outlined">
              image
              </span>
            <p class="pt-3 px-2">Ver todas las fotos</p>
          </div>
        </button>
      </a>
    </div>
  </div>

  </div>
  <%- include('./partials/footer') %>